# Copie para .env. NUNCA suba o .env para o GitHub.
# Para rodar localmente basta o JWT_SECRET: o banco é um arquivo SQLite (backend/urbanalert.db),
# criado automaticamente, sem instalar nada.

PORT=3001
JWT_SECRET=troque_por_um_segredo_com_32_ou_mais_caracteres
JWT_EXPIRES_IN=7d

# Senha do admin criado na primeira execução (padrão: admin123)
# ADMIN_EMAIL=admin@urbanalert.com
# ADMIN_PASSWORD=uma_senha_forte

# --- Opcional: usar PostgreSQL em vez de SQLite ---
# DATABASE_URL=postgresql://usuario:senha@host:5432/urbanalert     (é o que o Render fornece)
# ou: DB_ENGINE=postgres  +  DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD
# AUTO_SETUP=true       # PostgreSQL: cria tabelas/admin ao iniciar (usado no Render)
# DB_SSLMODE=require
# DB_SCHEMA=urbanalert   # PostgreSQL compartilhado com outro projeto: usa schema próprio
